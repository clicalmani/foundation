{
    "name": "clicalmani/foundation",
    "description": "Tonka fundation",
    "type": "library",
    "require": {
        "php": "^8.4",
        "vlucas/phpdotenv": ">=5.5.0",
        "nesbot/carbon": ">=2.16",
        "twig/twig": ">=3.0",
        "symfony/config": ">=7.3",
        "symfony/dependency-injection": ">=7.3",
        "symfony/cache": ">=7.3",
        "doctrine/inflector": "^2.1",
        "league/flysystem": "^3.33",
        "symfony/event-dispatcher": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/uid": "^7.4"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Clicalmani\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clicalmani\\Core\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../routing" },
        { "type": "path", "url": "../psr" },
        { "type": "path", "url": "../validation" },
        { "type": "path", "url": "../console" },
        { "type": "path", "url": "../database" },
        { "type": "path", "url": "../metrics" }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "clicalmani/routing": "@dev",
        "clicalmani/psr": "@dev",
        "clicalmani/validation": "@dev",
        "clicalmani/console": "@dev",
        "clicalmani/database": "@dev",
        "clicalmani/metrics": "@dev"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "clicalmani",
            "email": "clicalmani@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": false
}
